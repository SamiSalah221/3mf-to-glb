{
  "compilerOptions": {
    "outDir": "./dist-lib",
    "rootDir": "./src",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/lib/**/*.ts", "src/cli/**/*.ts", "src/types/**/*.ts"],
  // arLauncher is demo glue, not library surface: nothing under src/lib or
  // src/cli imports it, and its dynamic @google/model-viewer import would put
  // a heavy browser dependency on every consumer of the package. The demo
  // still imports it straight from src.
  "exclude": ["src/lib/arLauncher.ts"]
}
